{
  "manifest_version": 3,
  "name": "拾知 · 宠物陪读",
  "version": "0.3.4",
  "description": "划出不懂的地方，结合原文解释，把理解留下来。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "让拾知陪我读这页",
    "default_icon": "assets/icon.png"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sprites/*.png",
        "rich.css",
        "rich-frame.html",
        "rich-frame.js",
        "rich-frame.css",
        "vendor/mermaid.min.js",
        "vendor/katex.min.css",
        "vendor/fonts/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "sandbox": {
    "pages": [
      "rich-frame.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'",
    "sandbox": "sandbox allow-scripts; script-src 'self'; object-src 'none'; connect-src 'none'; img-src data:; base-uri 'none'"
  }
}
