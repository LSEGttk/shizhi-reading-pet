{
  "name": "reading-pet",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:crx": "npm run build && node scripts/package-crx.mjs",
    "test:rich": "node tests/rich-browser.mjs",
    "test:activation": "node tests/activation-browser.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.30",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
